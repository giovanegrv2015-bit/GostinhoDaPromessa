<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
   version="6.0">

    <!-- Acentos: sem isto o padrão da especificação é ISO-8859-1 ("Açúcar" viraria "AÃ§Ãºcar").
         O Tomcat 10+ já define UTF-8 no web.xml global dele; declarar aqui deixa o
         projeto independente da configuração do servidor onde for hospedado. -->
    <request-character-encoding>UTF-8</request-character-encoding>
    <response-character-encoding>UTF-8</response-character-encoding>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- JavaScript não consegue ler o cookie da sessão (protege contra roubo via XSS) -->
            <http-only>true</http-only>
        </cookie-config>
        <!-- id da sessão só em cookie, nunca na URL (;jsessionid=...), onde vazaria em histórico e logs -->
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Página de erro própria: a padrão do Tomcat mostra versão do servidor e stack trace para qualquer visitante.
         O erro completo continua indo para o log (docker compose logs app). -->
    <error-page>
        <error-code>404</error-code>
        <location>/erro.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/erro.html</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/erro.html</location>
    </error-page>
</web-app>
