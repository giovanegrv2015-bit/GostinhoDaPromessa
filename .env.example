# Copie este arquivo para ".env" (mesma pasta) e preencha. O .env NUNCA vai para o Git.

# --- Banco ---
#MYSQL_ROOT_PASSWORD=troque-por-uma-senha-forte
#MYSQL_DATABASE=estoque_db
#DB_PORT_EXTERNAL=3307
#DB_USER=root

# --- Primeiro administrador ---
# Criado automaticamente no primeiro login, se ainda não existir um usuário com esse nome.
# A senha precisa ter pelo menos 8 caracteres. Trocar a senha aqui depois NÃO altera um usuário já criado.
#ADMIN_USER=admin
#ADMIN_PASSWORD=troque-por-outra-senha-forte

# --- Usuários de demonstração (gerente / funcionario / visitante, senha demo1234) ---
# true só na sua máquina, para apresentar o projeto. Em produção: false.
#SEED_DEMO=false
